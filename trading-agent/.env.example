# Copy to .env (chmod 600 .env). NEVER commit .env. All values are secrets or deployment-specific.

# --- Database / cache -------------------------------------------------------------------------------
# PostgreSQL in production. SQLite works for local experiments only.
DATABASE_URL=postgresql+asyncpg://trading:CHANGE_ME@localhost:5432/trading_agent
# Optional (not required by the core system)
REDIS_URL=redis://localhost:6379/0

# --- Solana -----------------------------------------------------------------------------------------
# Comma-separated, priority order. Use paid providers with WebSocket support (Helius, Triton, QuickNode...).
# Public mainnet RPC rate limits make it unusable for real-time ingestion. URLs often embed API keys.
SOLANA_RPC_URLS=https://mainnet.helius-rpc.com/?api-key=CHANGE_ME,https://your-backup-rpc.example
SOLANA_WS_URLS=wss://mainnet.helius-rpc.com/?api-key=CHANGE_ME

# --- AI (optional; AI can only VETO, never approve) ---------------------------------------------------
ANTHROPIC_API_KEY=

# --- Alerts (optional) --------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- API auth -------------------------------------------------------------------------------------------
# admin: required for POST /system/* and /paper/reset (>= 32 random chars: `openssl rand -hex 32`)
API_ADMIN_TOKEN=
# read: required for GET endpoints when api.require_auth_for_reads=true
API_READ_TOKEN=

# --- Wallet (SHADOW simulation / LIVE only) -------------------------------------------------------------
# A DEDICATED trading wallet holding only the capital you are prepared to lose. Prefer a keypair file
# (solana-keygen JSON, chmod 600) mounted from a secret store; never bake it into an image.
WALLET_KEYPAIR_PATH=
# Alternative (less safe): base58 secret key
WALLET_PRIVATE_KEY_B58=

# --- LIVE arming ------------------------------------------------------------------------------------------
# LIVE mode refuses to start unless this equals exactly: I_UNDERSTAND_REAL_FUNDS_ARE_AT_RISK
LIVE_TRADING_CONFIRM=

# --- Config overrides (non-secret; any field of config/default.yaml) ------------------------------------
# TA__MODE=PAPER
# TA__RISK__MAX_DAILY_LOSS=0.03
# TA_CONFIG=config/default.yaml

# --- docker-compose / dashboard ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
# HTTP basic auth for the dashboard (user:password). The dashboard refuses to serve without it.
DASHBOARD_BASIC_AUTH=operator:CHANGE_ME
# Dashboard server -> API read token (same value as API_READ_TOKEN). Never exposed to the browser.
TA_API_READ_TOKEN=

# API + worker image. No secrets are baked in: everything comes from the environment / mounted files at runtime.
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN useradd --system --uid 10001 --home /app trader
COPY pyproject.toml README.md alembic.ini ./
COPY src ./src
COPY migrations ./migrations
COPY config ./config
RUN pip install --upgrade pip && pip install .
USER trader
ENV TA_CONFIG=/app/config/default.yaml
# default: API. The worker service overrides the command.
CMD ["ta", "api", "--host", "0.0.0.0"]
